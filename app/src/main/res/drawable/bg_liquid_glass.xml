<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 27 Liquid Glass approximation: tinted fill + darkened edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- darkened edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <!-- glass body inset -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#B82C2C2E"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
    <!-- specular top rim -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:topLeftRadius="15dp" android:topRightRadius="15dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
</layer-list>
