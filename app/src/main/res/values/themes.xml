<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LotusMembers" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/lotus_bg</item>
        <item name="android:navigationBarColor">@color/lotus_bg</item>
        <item name="android:windowBackground">@color/lotus_bg</item>
        <item name="colorPrimary">@color/lotus_blue</item>
        <item name="colorOnPrimary">@color/lotus_label</item>
        <item name="colorSurface">@color/lotus_surface</item>
        <item name="android:textColorPrimary">@color/lotus_label</item>
        <item name="android:textColorSecondary">@color/lotus_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/LotusWindowAnim</item>
    </style>
    <style name="LotusWindowAnim">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
